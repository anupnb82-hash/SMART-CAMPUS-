{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "role": { "type": "string", "enum": ["STUDENT", "FACULTY", "ADMIN"] },
        "department": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "role"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Campus facility and laboratory reservations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "enum": ["STUDENT", "FACULTY", "ADMIN"] },
        "resourceType": { "type": "string", "enum": ["CLASSROOM", "LABORATORY", "EQUIPMENT"] },
        "resourceId": { "type": "number" },
        "resourceName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "startTime": { "type": "string", "maxLength": 16 },
        "endTime": { "type": "string", "maxLength": 16 },
        "purpose": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "CANCELLED", "REJECTED", "COMPLETED", "NO_SHOW"] },
        "checkInStatus": { "type": "string", "enum": ["NOT_CHECKED_IN", "CHECKED_IN", "EXPIRED_NO_SHOW"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "resourceType", "resourceId", "date", "startTime", "endTime", "status"]
    },
    "WaitingList": {
      "title": "WaitingList",
      "description": "Rescue Engine priority waiting list entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "enum": ["STUDENT", "FACULTY", "ADMIN"] },
        "resourceType": { "type": "string", "enum": ["CLASSROOM", "LABORATORY", "EQUIPMENT"] },
        "resourceId": { "type": "number" },
        "resourceName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "startTime": { "type": "string", "maxLength": 16 },
        "endTime": { "type": "string", "maxLength": 16 },
        "purpose": { "type": "string", "maxLength": 500 },
        "priority": { "type": "number" },
        "status": { "type": "string", "enum": ["WAITING", "OFFERED", "ALLOCATED", "EXPIRED", "CANCELLED"] },
        "autoAllocateOptIn": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "resourceType", "resourceId", "date", "startTime", "endTime", "priority", "status"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Multi-turn Gemini AI Chat Session with system role instructions and history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "rolePersona": { "type": "string", "maxLength": 100 },
        "modelUsed": { "type": "string", "enum": ["gemini-4-argon", "gemini-3.8-flash", "gemini-3.1-flash-lite"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "rolePersona", "modelUsed"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles with authentication mapping"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Campus facility reservations and schedules"
    },
    "/waitlist/{waitId}": {
      "schema": { "$ref": "#/entities/WaitingList" },
      "description": "PriorityQueue waitlist entries for slot recovery"
    },
    "/users/{userId}/chat_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "User multi-turn Gemini conversation threads"
    }
  }
}
